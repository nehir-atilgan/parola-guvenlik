# Bu dosyayı ".env" adıyla kopyalayıp kendi değerlerinizi girin.
# .env dosyası .gitignore ile depodan hariç tutulur.

SECRET_KEY=buraya-uzun-rastgele-bir-deger-yazin

# SQLite veritabanı dosyasının yolu.
# Boş bırakılırsa backend/instance/parola_guvenlik.db kullanılır.
VERITABANI=

# Sızıntı kontrolü (Have I Been Pwned - Pwned Passwords, ücretsiz, anahtar gerekmez)
HIBP_API_URL=https://api.pwnedpasswords.com/range/

# Backend'e erişebilecek frontend adresleri (virgülle ayırın)
FRONTEND_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Yapay zekâ önerileri (ileriki haftalarda kullanılacak)
LLM_API_KEY=
